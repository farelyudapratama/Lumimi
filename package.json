{
  "name": "lumimi",
  "version": "0.1.1",
  "private": true,
  "description": "Lumimi: karakter Live2D yang dikendalikan AI (runtime Rust, logika TypeScript)",
  "scripts": {
    "dev": "cargo run -p live2d-core",
    "start": "cargo run -p live2d-core",
    "build": "bun run scripts/setup-core.mjs && bun run src/build.ts",
    "test": "bun test && bun run test/run-guards.js",
    "test:unit": "bun test",
    "test:guards": "bun run test/run-guards.js",
    "build:pet": "cd agent-shell && bunx @tauri-apps/cli build",
    "dev:pet": "cd agent-shell && bunx @tauri-apps/cli build --debug",
    "dist": "bun run src/dist.ts",
    "agent": "bun run src/cli/agent.ts",
    "setup:core": "bun run scripts/setup-core.mjs"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.0"
  },
  "dependencies": {
    "pixi.js": "8.20.1"
  }
}
